POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_hunt
POSTGRES_TEST_DB=job_hunt_test
SQL_ECHO=false
LOG_LEVEL=INFO

# Local LLM (Ollama). One GPU: concurrency is enforced by the llm queue.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=10m
# Which profiles/<name>.json postings are scored against.
LLM_DEFAULT_PROFILE=default

# Pause the GPU queue for GPU_COOLDOWN_SECONDS when the card is above this (Celsius).
GPU_MAX_TEMP_C=80
GPU_COOLDOWN_SECONDS=180
